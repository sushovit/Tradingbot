<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUTF8</key>
		<string>1</string>
		<key>TZ</key>
		<string>America/New_York</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>com.tradingbot.awake_week</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO__/venv/bin/python</string>
		<string>__REPO__/jobs/awake_week.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__REPO__/logs/awake_week.log</string>
	<key>StandardOutPath</key>
	<string>__REPO__/logs/awake_week.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>20</integer>
			<key>Minute</key>
			<integer>0</integer>
			<key>Weekday</key>
			<integer>0</integer>
		</dict>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
</dict>
</plist>
