# Copy to .env and fill in real values. NEVER commit .env.

# --- Alpaca PAPER trading (create keys under the Paper account at app.alpaca.markets) ---
ALPACA_API_KEY=your-alpaca-paper-api-key
ALPACA_SECRET_KEY=your-alpaca-paper-secret-key

# --- Intern's separate $1,000 paper account (second paper account in the same dashboard) ---
INTERN_ALPACA_API_KEY=your-intern-paper-api-key
INTERN_ALPACA_SECRET_KEY=your-intern-paper-secret-key

# --- AI gatekeeper ---
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Market news / sentiment ---
FINNHUB_API_KEY=your-finnhub-api-key

# --- Notifications (optional) ---
DISCORD_WEBHOOK_URL=your-discord-webhook-url
DISCORD_BOT_TOKEN=your-discord-bot-token
INTRADAY_CHANNEL_ID=your-discord-channel-id

# --- Optional data providers ---
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FINANCIAL_MODELING_PREP_API_KEY=your-fmp-key
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Local analyst (optional overrides) ---
# OLLAMA_URL=http://localhost:11434
# LOCAL_ANALYST_MODEL=qwen3:4b
